{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "logintel",
  "version": "0.1.0",
  "identifier": "com.logintel.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LogIntel — Linux Security Telemetry & Investigation",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Linux security telemetry and investigation platform",
    "longDescription": "LogIntel transforms raw Linux system telemetry into structured, searchable, evidence-backed security investigations without sending data outside the local machine.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64 | libgtk-3-0",
          "python3 (>= 3.10)"
        ],
        "section": "utils",
        "priority": "optional"
      }
    }
  }
}
